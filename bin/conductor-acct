#!/bin/bash
# Manage Conductor multi-account profiles for Claude Code and Codex.
#
# This file is dispatch only. Each command lives in lib/, one file per concern,
# because a single script grew past the point where anyone could find anything in
# it. Run `conductor-acct --help` for the commands.
set -euo pipefail

# Kept in step with VERSION in src/panel/index.ts: the CLI and the panel ship
# together and a mismatch between them is a bug, not a variation.
CONDUCTOR_ACCT_VERSION=0.2.0

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
BIN_DIR=$(dirname "$SELF")
REPO_DIR=$(dirname "$BIN_DIR")

# The routers source this one directly and must keep working with no build step,
# so it stays in bin/ beside them rather than moving to lib/.
# shellcheck source=./_resolve.sh
. "$BIN_DIR/_resolve.sh"

# A checkout has lib/ one level up from bin/. A deployed copy may have it beside.
LIB_DIR="$REPO_DIR/lib"
[ -d "$LIB_DIR" ] || LIB_DIR="$BIN_DIR/lib"
[ -d "$LIB_DIR" ] || { echo "conductor-acct: cannot find lib/ near $BIN_DIR" >&2; exit 1; }

# Configuration shared by everything in lib/. One directive per line, because the
# linter cannot follow the sourcing loop below and so reads each as unused here.
# The first two are overridable so the test suite never touches a real Conductor
# install.
# shellcheck disable=SC2034
CONDUCTOR_SETTINGS="${CONDUCTOR_ACCT_SETTINGS_FILE:-$HOME/.conductor/settings.toml}"
# shellcheck disable=SC2034
COMMANDS_DIR="${CONDUCTOR_ACCT_COMMANDS_DIR:-$HOME/.claude/commands}"
# shellcheck disable=SC2034
SHARED_LINKS="projects skills plugins commands agents settings.json CLAUDE.md"
# shellcheck disable=SC2034
INSTALL_BIN="$ACCOUNTS_ROOT/bin"

# Order matters only in that agents.sh defines die(), which the rest use.
for part in agents labels locate mask profiles routes report ask query login \
            settings setup usage; do
    # shellcheck source=/dev/null
    . "$LIB_DIR/$part.sh"
done

cmd=${1:-}
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
    init) cmd_init "$@" ;;
    setup) cmd_setup "$@" ;;
    add) cmd_add "$@" ;;
    login) cmd_login "$@" ;;
    logout) cmd_logout "$@" ;;
    remove) cmd_remove "$@" ;;
    list) cmd_list "$@" ;;
    mask) mask_email "${1:-}" ;;
    use) cmd_use "$@" ;;
    assign) cmd_assign "$@" ;;
    unassign) cmd_unassign "$@" ;;
    bind) cmd_bind "$@" ;;
    unbind) cmd_unbind "$@" ;;
    which) cmd_which "$@" ;;
    status) cmd_status "$@" ;;
    check) cmd_check "$@" ;;
    json) cmd_json "$@" ;;
    resolve) cmd_resolve "$@" ;;
    resolve-repo) cmd_resolve_repo "$@" ;;
    workspaces) cmd_workspaces "$@" ;;
    repos) cmd_repos "$@" ;;
    login-start) cmd_login_start "$@" ;;
    login-code) cmd_login_code "$@" ;;
    login-status) cmd_login_status "$@" ;;
    login-cancel) cmd_login_cancel "$@" ;;
    ask) cmd_ask "$@" ;;
    update) cmd_update "$@" ;;
    sessions) cmd_sessions "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|--version|-V) echo "conductor-acct $CONDUCTOR_ACCT_VERSION" ;;
    ''|-h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try --help)" ;;
esac
