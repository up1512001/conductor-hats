#!/bin/bash
# Dispatch only. Commands live in lib/, one file per concern.
set -euo pipefail

# Must match VERSION in src/panel/index.ts; a test asserts it.
CONDUCTOR_ACCT_VERSION=0.2.0

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
BIN_DIR=$(dirname "$SELF")
REPO_DIR=$(dirname "$BIN_DIR")

# In bin/ rather than lib/: the routers source it directly on every spawn.
# shellcheck source=./_resolve.sh
. "$BIN_DIR/_resolve.sh"

# One level up in a checkout, beside bin/ in a deployed copy.
LIB_DIR="$REPO_DIR/lib"
[ -d "$LIB_DIR" ] || LIB_DIR="$BIN_DIR/lib"
[ -d "$LIB_DIR" ] || { echo "conductor-acct: cannot find lib/ near $BIN_DIR" >&2; exit 1; }

# Shared by lib/. The linter cannot follow the sourcing loop, hence the
# directives. The first two are overridable so tests touch no real install.
# shellcheck disable=SC2034
CONDUCTOR_SETTINGS="${CONDUCTOR_ACCT_SETTINGS_FILE:-$HOME/.conductor/settings.toml}"
# shellcheck disable=SC2034
COMMANDS_DIR="${CONDUCTOR_ACCT_COMMANDS_DIR:-$HOME/.claude/commands}"
# shellcheck disable=SC2034
SHARED_LINKS="projects skills plugins commands agents settings.json CLAUDE.md"
# shellcheck disable=SC2034
INSTALL_BIN="$ACCOUNTS_ROOT/bin"

# agents.sh defines die(), which the rest use.
for part in agents labels locate mask profiles routes report ask query login \
            settings setup usage; do
    # shellcheck source=/dev/null
    . "$LIB_DIR/$part.sh"
done

cmd=${1:-}
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
    init) cmd_init "$@" ;;
    setup) cmd_setup "$@" ;;
    add) cmd_add "$@" ;;
    login) cmd_login "$@" ;;
    logout) cmd_logout "$@" ;;
    remove) cmd_remove "$@" ;;
    list) cmd_list "$@" ;;
    mask) mask_email "${1:-}" ;;
    use) cmd_use "$@" ;;
    assign) cmd_assign "$@" ;;
    unassign) cmd_unassign "$@" ;;
    bind) cmd_bind "$@" ;;
    unbind) cmd_unbind "$@" ;;
    which) cmd_which "$@" ;;
    status) cmd_status "$@" ;;
    check) cmd_check "$@" ;;
    json) cmd_json "$@" ;;
    resolve) cmd_resolve "$@" ;;
    resolve-repo) cmd_resolve_repo "$@" ;;
    workspaces) cmd_workspaces "$@" ;;
    repos) cmd_repos "$@" ;;
    login-start) cmd_login_start "$@" ;;
    login-code) cmd_login_code "$@" ;;
    login-status) cmd_login_status "$@" ;;
    login-cancel) cmd_login_cancel "$@" ;;
    ask) cmd_ask "$@" ;;
    update) cmd_update "$@" ;;
    sessions) cmd_sessions "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|--version|-V) echo "conductor-acct $CONDUCTOR_ACCT_VERSION" ;;
    ''|-h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try --help)" ;;
esac
