#!/bin/sh
# Conductor multi-account router for Claude Code.
#
# Point Conductor's `claude_code_executable_path` at this file. Conductor spawns
# the agent with the workspace as cwd and passes --session-id=, so this can pick
# an account per workspace and keep it for that session's life.
#
# Two invariants, because this sits in front of every agent Conductor starts:
#   1. Fail open. Decisions happen in a subshell, so a broken _resolve.sh costs
#      the routing, not the agents.
#   2. exec, never fork. The spare host and Conductor's stdio pipes both assume
#      a direct child.

SELF=$0
case "$SELF" in
    /*) ;;
    *) SELF=$(cd "$(dirname "$0")" 2>/dev/null && pwd)/${0##*/} ;;
esac
LIB="${SELF%/*}/_resolve.sh"

# Depth, not a flag: the variable is inherited by everything the agent starts, so
# launching Conductor from a routed session made a flag refuse every agent. One
# stale generation is tolerated, a real loop trips on the second.
CONDUCTOR_ACCOUNTS_DEPTH=${CONDUCTOR_ACCOUNTS_DEPTH:-0}
case "$CONDUCTOR_ACCOUNTS_DEPTH" in
    ''|*[!0-9]*) CONDUCTOR_ACCOUNTS_DEPTH=0 ;;
esac
if [ "$CONDUCTOR_ACCOUNTS_DEPTH" -ge 2 ]; then
    echo "claude-router: refusing to route into itself (depth $CONDUCTOR_ACCOUNTS_DEPTH)" >&2
    exit 70
fi
CONDUCTOR_ACCOUNTS_DEPTH=$((CONDUCTOR_ACCOUNTS_DEPTH + 1))
export CONDUCTOR_ACCOUNTS_DEPTH
CONDUCTOR_ACCOUNTS_ROUTING=claude
export CONDUCTOR_ACCOUNTS_ROUTING

# A repository binding sets CLAUDE_CONFIG_DIR before we run. Tell the resolver,
# so it only overrides that when a route names this workspace exactly.
ENV_BOUND=0
[ -n "${CLAUDE_CONFIG_DIR:-}" ] && ENV_BOUND=1

# One subshell, two lines out: the config dir to use and the binary to exec.
# A syntax error or a failed source dies in here and leaves DECISION empty.
DECISION=$(
    [ -r "$LIB" ] || exit 0
    # shellcheck source=./_resolve.sh
    . "$LIB"
    load_config
    _ws=$(workspace_dir)
    _sid=$(session_id_from_args "$@")
    _profile=$(decide_profile claude "$_ws" "$_sid" "$ENV_BOUND")
    if [ -n "$_profile" ]; then
        _dir="$ACCOUNTS_ROOT/claude/$_profile"
        if [ -d "$_dir" ]; then
            printf 'dir %s\n' "$_dir"
        else
            printf 'warn profile %s has no config dir at %s\n' "$_profile" "$_dir"
        fi
    fi
    if _bin=$(resolve_agent_binary claude "$SELF"); then
        printf 'bin %s\n' "$_bin"
    fi
) 2>/dev/null

CLAUDE_BIN=
while IFS= read -r _line; do
    case "$_line" in
        'dir '*) CLAUDE_CONFIG_DIR="${_line#dir }"; export CLAUDE_CONFIG_DIR ;;
        'bin '*) CLAUDE_BIN="${_line#bin }" ;;
        'warn '*) echo "claude-router: ${_line#warn } (using the account already configured)" >&2 ;;
    esac
done <<EOF
$DECISION
EOF

# Last resort, so a broken install still starts an agent on the default account.
if [ -z "$CLAUDE_BIN" ]; then
    for _c in "${CONDUCTOR_ACCOUNTS_CLAUDE_BIN:-}" \
              "$HOME/Library/Application Support/com.conductor.app/bin/claude"; do
        if [ -n "$_c" ] && [ -x "$_c" ]; then CLAUDE_BIN="$_c"; break; fi
    done
fi
if [ -z "$CLAUDE_BIN" ]; then
    CLAUDE_BIN=$(command -v claude 2>/dev/null)
    [ "$CLAUDE_BIN" = "$SELF" ] && CLAUDE_BIN=
fi
if [ -z "$CLAUDE_BIN" ]; then
    echo "claude-router: could not locate the real claude binary" >&2
    exit 127
fi

exec "$CLAUDE_BIN" "$@"
